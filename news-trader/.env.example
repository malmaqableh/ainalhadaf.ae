# Copy to .env. Never commit .env.

# Claude news analysis (analysis.engine: claude)
ANTHROPIC_API_KEY=

# NewsAPI (only if a newsapi source is enabled)
NEWSAPI_KEY=

# Exchange keys: only for mode testnet/live. TRADE permission only - never WITHDRAW.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Required in addition to mode: live. Leave unset for paper/testnet.
# NEWSBOT_CONFIRM_LIVE=YES

# Telegram alerts (alerts.telegram: true)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts (alerts.email: true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
